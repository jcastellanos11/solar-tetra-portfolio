{
  "name": "solar-tetra-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run check:content",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/validate-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check:content": "node scripts/validate-content.mjs",
    "test": "node --import ./scripts/register-typescript.mjs --test tests/*.test.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.4.0",
    "react": ">=19.1.0 <19.4.0",
    "react-dom": ">=19.1.0 <19.4.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
